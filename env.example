# Скопируйте в .env. Любая модель, которую поддерживает LiteLLM: openrouter/..., openai/... и т. д.
# Рекомендуемая конфигурация (на ней работает демо-сервер): YandexGPT Lite, один API-ключ сервисного аккаунта
# с ролями ai.languageModels.user, ai.speechkit-stt.user, ai.speechkit-tts.user в YANDEX_API_KEY ниже:
#   LLM_MODEL=openai/gpt://<folder_id>/yandexgpt-lite/latest
#   LLM_API_BASE=https://llm.api.cloud.yandex.net/v1
#   LLM_FALLBACKS=
# Ниже пример на бесплатных моделях OpenRouter
LLM_MODEL=openrouter/qwen/qwen3.8-27b:free
# модель для генерации карточки сценария по описанию; пусто = та же, а при YandexGPT Lite — YandexGPT Pro
LLM_CARDGEN_MODEL=
# модель разметки ходов (от неё зависит исход сессии); пусто = та же, что LLM_MODEL, а при YandexGPT Lite — YandexGPT Pro
LLM_LABEL_MODEL=
# модель судьи (разбор после сессии); пусто = та же, что LLM_MODEL, а при YandexGPT Lite — YandexGPT Pro
LLM_JUDGE_MODEL=
# Для OpenRouter можно не задавать, если в системе есть переменная OPENROUTER_API_KEY (docker compose передаёт её в контейнер)
LLM_API_KEY=
# Запасные модели через запятую, если основная упёрлась в лимит
LLM_FALLBACKS=openrouter/nvidia/nemotron-3-super-120b-a12b:free,openrouter/google/gemma-4-31b-it:free
# LLM_API_BASE=
# true — работать без LLM, на правилах
OFFLINE_MODE=false
# Запасной токен владельца площадки: с ним меняется любой сценарий, включая встроенные и зафиксированные. Пусто — токена нет, фиксирует только администратор организации
ADMIN_TOKEN=
# Голос и 3D-аватар: Yandex SpeechKit v3 (распознавание голосовых и озвучка собеседника).
# API-ключ сервисного аккаунта с ролями ai.speechkit-stt.user и ai.speechkit-tts.user. Пусто — голосовые не распознаются,
# а аватар в режиме «3D и голос» двигает губами по тексту беззвучно
YANDEX_API_KEY=
# Каталог Yandex Cloud; для API-ключа сервисного аккаунта можно не задавать
YANDEX_FOLDER_ID=
# Папка для загруженных GLB-аватаров и голосовых; пусто — backend/uploads
# UPLOADS_DIR=
# AVATAR_MAX_MB=30
# VOICE_MAX_SECONDS=30
# Нормализация распознанной речи (числа цифрами, пунктуация). По умолчанию выключена: судья видит речь как есть, со словами-паразитами
# VOICE_TEXT_NORMALIZATION=false
