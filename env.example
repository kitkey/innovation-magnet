# Скопируйте в .env. Любая модель, которую поддерживает LiteLLM: openrouter/..., openai/... и т. д.
LLM_MODEL=openrouter/qwen/qwen3.8-27b:free
# Для OpenRouter можно не задавать, если в системе есть переменная OPENROUTER_API_KEY (docker compose передаёт её в контейнер)
LLM_API_KEY=
# Запасные модели через запятую, если основная упёрлась в лимит
LLM_FALLBACKS=openrouter/nvidia/nemotron-3-super-120b-a12b:free,openrouter/google/gemma-4-31b-it:free
# LLM_API_BASE=
# true — работать без LLM, на правилах
OFFLINE_MODE=false
# Токен администратора: фиксация сценариев и правка зафиксированных. Пусто — фиксировать может любой
ADMIN_TOKEN=
